# Copy this file to .env and fill in values.
# docker-compose reads this file automatically.

# --- Inference provider -------------------------------------------------------
# "gemini"  → Google Gemini API (recommended for production)
# "ollama"  → local Ollama via host.docker.internal (advanced)
INFERENCE_PROVIDER=gemini

# --- Google Gemini API key (required when INFERENCE_PROVIDER=gemini) ----------
GOOGLE_API_KEY=your_gemini_api_key_here

# --- Gemini model (optional) --------------------------------------------------
GEMINI_MODEL=gemini-2.5-flash

# --- Ollama (only needed when INFERENCE_PROVIDER=ollama inside Docker) --------
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=gemma4:e4b

# --- Network ------------------------------------------------------------------
# CORS origin seen by the browser. Change to your domain in production.
FRONTEND_ORIGIN=http://localhost
# Host port the frontend is published on
PORT=80
