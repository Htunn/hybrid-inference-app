# Environment: "development" routes to local Ollama, "production" routes to Google Gemini
NODE_ENV=development

# Only required when NODE_ENV=production
GOOGLE_API_KEY=

# Local Ollama base URL (change if you run Ollama on a different port)
OLLAMA_BASE_URL=http://localhost:11434

# Allowed CORS origin for the frontend.
# In development this can be a wildcard; in production set your Vercel URL.
# Example: https://my-app.vercel.app
FRONTEND_ORIGIN=http://localhost:5173
