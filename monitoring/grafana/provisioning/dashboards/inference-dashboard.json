{
  "dashboard": {
    "title": "InferMesh Metrics",
    "timezone": "browser",
    "schemaVersion": 16,
    "version": 0,
    "refresh": "10s",
    "panels": [
      {
        "id": 1,
        "title": "Requests per Second",
        "type": "graph",
        "gridPos": {
          "x": 0,
          "y": 0,
          "w": 12,
          "h": 8
        },
        "targets": [
          {
            "expr": "rate(inference_requests_total[1m])",
            "legendFormat": "{{backend}} - {{status}}"
          }
        ]
      },
      {
        "id": 2,
        "title": "Tokens per Second (Throughput)",
        "type": "graph",
        "gridPos": {
          "x": 12,
          "y": 0,
          "w": 12,
          "h": 8
        },
        "targets": [
          {
            "expr": "rate(inference_tokens_total[1m])",
            "legendFormat": "{{backend}}"
          }
        ]
      },
      {
        "id": 3,
        "title": "Time to First Token (P50, P95, P99)",
        "type": "graph",
        "gridPos": {
          "x": 0,
          "y": 8,
          "w": 12,
          "h": 8
        },
        "targets": [
          {
            "expr": "histogram_quantile(0.5, rate(inference_latency_seconds_bucket[5m]))",
            "legendFormat": "P50"
          },
          {
            "expr": "histogram_quantile(0.95, rate(inference_latency_seconds_bucket[5m]))",
            "legendFormat": "P95"
          },
          {
            "expr": "histogram_quantile(0.99, rate(inference_latency_seconds_bucket[5m]))",
            "legendFormat": "P99"
          }
        ]
      },
      {
        "id": 4,
        "title": "Prefix Cache Hit Rate",
        "type": "stat",
        "gridPos": {
          "x": 12,
          "y": 8,
          "w": 6,
          "h": 4
        },
        "targets": [
          {
            "expr": "rate(prefix_cache_hits_total[5m]) / (rate(prefix_cache_hits_total[5m]) + rate(prefix_cache_misses_total[5m]))",
            "legendFormat": "Hit Rate"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "percentunit",
            "min": 0,
            "max": 1
          }
        }
      },
      {
        "id": 5,
        "title": "Queue Length",
        "type": "graph",
        "gridPos": {
          "x": 18,
          "y": 8,
          "w": 6,
          "h": 4
        },
        "targets": [
          {
            "expr": "queue_length",
            "legendFormat": "Requests in Queue"
          }
        ]
      },
      {
        "id": 6,
        "title": "Average Batch Size",
        "type": "stat",
        "gridPos": {
          "x": 12,
          "y": 12,
          "w": 6,
          "h": 4
        },
        "targets": [
          {
            "expr": "rate(batch_size_sum[5m]) / rate(batch_size_count[5m])",
            "legendFormat": "Avg Batch Size"
          }
        ]
      },
      {
        "id": 7,
        "title": "Total Requests (by backend)",
        "type": "stat",
        "gridPos": {
          "x": 18,
          "y": 12,
          "w": 6,
          "h": 4
        },
        "targets": [
          {
            "expr": "sum by (backend) (inference_requests_total)",
            "legendFormat": "{{backend}}"
          }
        ]
      }
    ]
  }
}