# --- Inference provider -------------------------------------------------------
# "ollama"  → local Ollama (development / air-gapped)
# "gemini"  → Google Gemini API (production)
INFERENCE_PROVIDER=ollama

# --- Google Gemini (required when INFERENCE_PROVIDER=gemini) ------------------
GOOGLE_API_KEY=

# --- Gemini model (optional override) -----------------------------------------
GEMINI_MODEL=gemini-2.5-flash

# --- Local Ollama settings (required when INFERENCE_PROVIDER=ollama) ----------
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma4:e4b

# --- CORS ---------------------------------------------------------------------
# In development → Vite dev server.  In Docker production → your domain or http://localhost
FRONTEND_ORIGIN=http://localhost:5173
